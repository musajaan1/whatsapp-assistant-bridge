# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Allowed WhatsApp sender ID/number (only messages from this number will be processed)
ALLOWED_WHATSAPP_SENDER=

# Comma-separated list of drive or folder paths to search (e.g. C:\Users\YourName\Documents,D:\)
SEARCH_ROOT_FOLDERS=

# Maximum file size allowed to be sent over WhatsApp (in MB)
MAX_FILE_SIZE_MB=95

# Directory where application logs and conversation logs will be stored
LOG_FOLDER=./logs
